source "https://rubygems.org"

gem "jekyll", "~> 4.3"

# webrick was removed from Ruby's stdlib in Ruby 3.0 but `jekyll serve` needs it.
gem "webrick", "~> 1.8"

# Ruby 3.4 dropped these from the default gems; several Jekyll dependencies
# still expect them. Harmless on older Rubies.
gem "csv"
gem "base64"
gem "logger"
gem "bigdecimal"
